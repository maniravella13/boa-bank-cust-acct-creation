    <http:listener-config name="boa-bank-cust-acct-creation-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="${http.port}" />
    </http:listener-config>
    <apikit:config name="boa-bank-cust-acct-creation-config" api="resource::7088bc54-caf8-4151-b3b3-ea28854e26af:boa-bank-cust-acct-creation:1.0.1:raml:zip:boa-bank-cust-acct-creation.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<configuration-properties doc:name="Configuration properties" doc:id="17cd5234-aba0-41d8-bc0f-462c59a91d86" file="dev.yaml" />
	<snowflake:snowflake-config name="Snowflake_Config" doc:name="Snowflake Config" doc:id="4e6470c0-fab8-4b38-bd9d-6be7c8328b75" >
		<snowflake:snowflake-connection accountName="${db.Account Name}" warehouse="${db.Warehouse}" database="${db.Database}" schema="${db.Schema}" user="${db.User}" password="${db.Password}" role="${db.Role}" />
	</snowflake:snowflake-config>
	<email:smtp-config name="Email_SMTP" doc:name="Email SMTP" doc:id="44493a7a-6084-4553-bf7b-05bc76f7d296" >
		<email:smtp-connection host="${email.host}" port="${email.port}" user="${email.user}" password="${email.password}" >
			<email:properties >
				<email:property key="mail.smtp.starttls.enable" value="true" />
			</email:properties>
		</email:smtp-connection>
	</email:smtp-config>
	<file:config name="File_Config" doc:name="File Config" doc:id="41ea0597-064e-4662-8fe1-f689f5480b3c" >
		<file:connection workingDir="C:\Users\pavit\Downloads\logo" />
	</file:config>
	<flow name="boa-bank-cust-acct-creation-main">
        <http:listener config-ref="boa-bank-cust-acct-creation-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <logger level="INFO" doc:name="Logger" doc:id="70d55180-ef50-4cae-aa97-7958ecf51592" message='#["Flow Started"]'/>
		<apikit:router config-ref="boa-bank-cust-acct-creation-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
